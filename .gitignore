# ==========================================
# AIRFLOW & DOCKER SPECIFIQUE
# ==========================================
# On ignore le contenu des dossiers mais on garde la structure via .gitkeep
logs/*
!logs/.gitkeep

plugins/*
!plugins/.gitkeep

# Dossier de config (optionnel : garde le si tu veux partager ta config)
# config/*
# !config/.gitkeep

# Base de données locale (si tu as mappé un volume postgres)
postgres-data/

# Fichier d'environnement (contient ton UID et secrets)
.env

# ==========================================
# PYTHON & ENVIRONNEMENT (Ton existant)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.DS_Store

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Django / Flask
*.log
local_settings.py
db.sqlite3
instance/
.webassets-cache

# Jupyter / pyenv / Environments
.ipynb_checkpoints
.python-version
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Outils divers
.mypy_cache/
.spyderproject
.spyproject
.ropeproject